{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.meridian.invalid/briefing-schema.json",
  "title": "Meridian daily Codex briefing overlay",
  "description": "Apply to the exact collection snapshot. Every selected briefing item needs a complete bilingual analysis overlay, an exactly matching summary, and an attention assessment so it appears in the ranked dashboard. Evidence must include the article URL. Publisher translation is imported separately; these cross-array constraints are checked by apply_briefing.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "collectionGeneratedAt",
    "briefing",
    "articles"
  ],
  "properties": {
    "collectionGeneratedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Copy dashboard.generatedAt exactly, without reformatting."
    },
    "briefing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "overview",
        "items"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/bilingual"
        },
        "overview": {
          "$ref": "#/$defs/bilingual"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "description": "Select significant developments across the rolling 30-day window, carrying important unread events forward. Do not fill a daily quota with less important new reporting.",
          "items": {
            "$ref": "#/$defs/briefingItem"
          }
        },
        "sectionNotes": {
          "$ref": "#/$defs/sectionNotes"
        }
      }
    },
    "articles": {
      "type": "array",
      "maxItems": 100,
      "description": "Complete article-detail overlays. Every selected briefing item requires an exactly matching bilingual summary and an attention assessment. Non-selected extra analyses may omit attention.",
      "items": {
        "$ref": "#/$defs/articleOverlay"
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        },
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "[㐀-䶿一-鿿]",
          "description": "Chinese prose is required; copying English into zh does not satisfy bilingual coverage."
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          }
        }
      }
    },
    "briefingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "articleId",
        "summary",
        "whyItMatters",
        "uncertainty",
        "watch",
        "evidence"
      ],
      "properties": {
        "articleId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "$ref": "#/$defs/bilingual"
        },
        "whyItMatters": {
          "$ref": "#/$defs/bilingual"
        },
        "uncertainty": {
          "$ref": "#/$defs/bilingual"
        },
        "watch": {
          "$ref": "#/$defs/bilingual"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "articleOverlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "articleId",
        "summary",
        "analysis"
      ],
      "properties": {
        "articleId": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "$ref": "#/$defs/bilingual"
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context",
            "implications",
            "uncertainty",
            "watch",
            "evidence"
          ],
          "properties": {
            "context": {
              "$ref": "#/$defs/bilingual"
            },
            "implications": {
              "$ref": "#/$defs/bilingual"
            },
            "uncertainty": {
              "$ref": "#/$defs/bilingual"
            },
            "watch": {
              "$ref": "#/$defs/bilingual"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "attention": {
          "$ref": "#/$defs/attention",
          "description": "Required semantically for every selected briefing item; optional for non-selected extra analysis overlays."
        },
        "reverified": {
          "type": "boolean",
          "description": "Set true only after actually rechecking the factual evidence. Identical copied factual analysis keeps its original analyzedAt timestamp unless explicitly reverified; attention.reviewedAt is a separate priority assessment."
        }
      }
    },
    "attention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importance",
        "reason",
        "horizonDays",
        "keepUntilRead",
        "eventKey",
        "updateKey"
      ],
      "properties": {
        "importance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reason": {
          "$ref": "#/$defs/bilingual"
        },
        "horizonDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "keepUntilRead": {
          "type": "boolean"
        },
        "eventKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._:/-]+$",
          "description": "Stable semantic identifier shared by reports about the same event, not an article URL or date."
        },
        "updateKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._:/-]+$",
          "description": "Stable identifier for the latest material development. Keep unchanged for duplicate/minor reports; change only with sourced substantive new facts."
        }
      }
    },
    "sectionNoteTitle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "[㐀-䶿一-鿿]",
          "description": "Chinese prose is required; copying English into zh does not satisfy bilingual coverage."
        }
      }
    },
    "sectionNoteSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 650,
          "pattern": "\\S"
        },
        "zh": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "[㐀-䶿一-鿿]",
          "description": "Chinese prose is required; copying English into zh does not satisfy bilingual coverage."
        }
      },
      "description": "Concise paired prose: English at most 75 whitespace-delimited words and 650 characters; Chinese at most 180 characters; at most two paragraphs in either language. Aim for 20–40 English words and 40–90 Chinese characters. Word/paragraph limits are also checked by the importer."
    },
    "sectionNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "articleIds"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/sectionNoteTitle"
        },
        "summary": {
          "$ref": "#/$defs/sectionNoteSummary",
          "description": "Latest development, separate from the explanatory background."
        },
        "articleIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Cite article IDs with complete current bilingual analysis or a retained reviewed snapshot. Every linked article must belong to the topic category or relatedCategories, except in the unrestricted all scope."
        },
        "background": {
          "$ref": "#/$defs/sectionNoteSummary",
          "description": "Previously reviewed background needed to understand the latest development in summary. Supply for newly authored notes; optional for legacy compatibility. Use sourced article.analysis.context, never raw-source speculation. Same bilingual readability limits as summary."
        }
      }
    },
    "sectionNotes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Optional topic-specific edited notes. For newly authored notes, provide background before the latest-development summary; legacy notes without background remain accepted. Omit unsupported topics rather than falling back to the global overview. Editing a note does not reverify the facts or reset article analyzedAt. Known-ID/review and topic membership constraints are checked by apply_briefing.py.",
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sectionNote"
          }
        },
        "us": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sectionNote"
          }
        },
        "world": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sectionNote"
          }
        },
        "economy": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sectionNote"
          }
        },
        "crisis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sectionNote"
          }
        },
        "sdg": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sectionNote"
          }
        },
        "industry": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sectionNote"
          }
        }
      }
    }
  }
}
